# Copy these into Vercel: Project -> Settings -> Environment Variables.
# NEVER commit real values to GitHub.

# Admin login for /admin.html
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-strong-password

# Instant order alerts via Telegram Bot (100% free, unlimited — RECOMMENDED)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

# Optional backup: Email alerts via Resend (free up to 3,000/month)
# RESEND_API_KEY=re_xxxxxxxx
# NOTIFY_EMAIL=aniakwubenedicta4@gmail.com

# Database: added automatically when you connect Upstash Redis from the Vercel Storage tab
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
