# Copy these into Vercel: Project -> Settings -> Environment Variables.
# NEVER commit real values to GitHub.

# Admin login for /admin.html
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-strong-password

# Your WhatsApp number to receive order alerts (country code + digits, no +)
NOTIFY_WHATSAPP=2349066434486

# --- OPTION A (RECOMMENDED, OFFICIAL): Meta WhatsApp Business Cloud API ---
# WHATSAPP_ACCESS_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WHATSAPP_TEMPLATE_NAME=new_order_alert
# WHATSAPP_TEMPLATE_LANG=en_US

# --- OPTION B (FREE, 2-MIN SETUP): TextMeBot WhatsApp API ---
# TEXTMEBOT_APIKEY=your-textmebot-key

# Database: added automatically when you connect Upstash Redis from the Vercel Storage tab
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
