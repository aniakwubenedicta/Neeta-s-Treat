# Copy these into Vercel: Project -> Settings -> Environment Variables.
# NEVER commit real values to GitHub.

# Admin login for /admin.html
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-strong-password

# Instant phone alerts via ntfy (100% free, 1-minute setup)
# Pick a long, hard-to-guess secret topic name and subscribe to it in the ntfy app on your phone:
NTFY_TOPIC=neetaa-orders-change-me-to-something-secret

# Database: added automatically when you connect Upstash Redis from the Vercel Storage tab
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
